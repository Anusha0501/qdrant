# Copy this file to .env and fill in real values. Never commit the real .env.

# Qdrant Cloud or self-hosted endpoint, e.g. https://xyz.eu-central.aws.cloud.qdrant.io
QDRANT_URL=REPLACE_ME
# Qdrant API key (leave blank for local unauthenticated instances)
QDRANT_API_KEY=REPLACE_ME

# Name of the Qdrant collection to create / query
COLLECTION_NAME=eu_reg_directives

# Embedding provider: "fastembed" (local, no external calls) or "cohere"
EMBEDDING_PROVIDER=fastembed

# Only required if EMBEDDING_PROVIDER=cohere
COHERE_API_KEY=REPLACE_ME

# FastEmbed model names (safe defaults, override if needed).
# Dense size is read from the model: bge-small-en-v1.5 is 384,
# Cohere embed-multilingual-v3.0 is 1024. The collection uses that size.
# Learned sparse default is SPLADE. This FastEmbed pin does not ship BGE-M3
# sparse; the other learned-sparse option is Qdrant/bm42-all-minilm-l6-v2-attentions.
DENSE_MODEL_NAME=BAAI/bge-small-en-v1.5
SPARSE_MODEL_NAME=prithivida/Splade_PP_en_v1

# Hugging Face dataset + config + pinned revision for reproducibility.
# joelniklaus/eurlex no longer exists on the Hub (404). LexGLUE's "eurlex"
# config is the English EU-legislation split (text + EuroVoc labels).
HF_DATASET_NAME=coastalcph/lex_glue
HF_DATASET_CONFIG=eurlex
HF_DATASET_REVISION=main
