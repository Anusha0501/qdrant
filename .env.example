# Copy this file to .env and fill in real values. Never commit the real .env.

# Qdrant Cloud or self-hosted endpoint, e.g. https://xyz.eu-central.aws.cloud.qdrant.io
QDRANT_URL=REPLACE_ME
# Qdrant API key (leave blank for local unauthenticated instances)
QDRANT_API_KEY=REPLACE_ME

# Name of the Qdrant collection to create / query
COLLECTION_NAME=eu_reg_directives

# Embedding provider: "fastembed" (local, no external calls) or "cohere"
EMBEDDING_PROVIDER=fastembed

# Only required if EMBEDDING_PROVIDER=cohere
COHERE_API_KEY=REPLACE_ME

# FastEmbed model names (safe defaults, override if needed)
DENSE_MODEL_NAME=BAAI/bge-small-en-v1.5
SPARSE_MODEL_NAME=prithivida/Splade_PP_en_v1

# Hugging Face dataset + pinned revision for reproducibility
HF_DATASET_NAME=joelniklaus/eurlex
HF_DATASET_REVISION=main
